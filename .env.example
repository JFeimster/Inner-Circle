# ==============================================================================
# Inner Circle — Environment Variable Template
# Never commit real secret values. Configure production values in Vercel Settings.
# ==============================================================================

# --- Browser Auth (Public — safe for Vite client bundle) ---
# Inner Circle Supabase project URL (https://thdnmgmojhhhtjlhbwvn.supabase.co)
VITE_SUPABASE_URL=
# Inner Circle Supabase publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server Database & Auth Verification (Server-only — NEVER prefix with VITE_) ---
SUPABASE_URL=
# Preferred modern Supabase secret key (sb_secret_...)
SUPABASE_SECRET_KEY=
# Compatibility fallback only if SUPABASE_SECRET_KEY is not yet configured
SUPABASE_SERVICE_ROLE_KEY=

# --- AI Studio (Server-only — keep AI_STUDIO_LIVE_ENABLED=false until activation) ---
GEMINI_API_KEY=
AI_STUDIO_LIVE_ENABLED=false
GEMINI_CHAT_MODEL=gemini-4-hydrogen
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_FILE_MODEL=gemini-4-hydrogen

# --- Verified Billing Webhook Boundary (Server-only — leave blank until live billing) ---
BILLING_WEBHOOK_SECRET=

# --- Application URL ---
APP_URL=

# --- Explicit Local Development Only (Ignored/blocked in production and on Vercel) ---
ALLOW_LOCAL_SQLITE=true
LOCAL_SQLITE_PATH=data/inner-circle-local.db

# Exact trusted preview hosts, comma-separated. Leave blank for localhost only.
VITE_ALLOWED_HOSTS=
