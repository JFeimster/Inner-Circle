# GEMINI_API_KEY: Required for server-side Gemini AI Studio calls.
# Configure in AI Studio Secrets or Vercel Project Settings -> Environment Variables.
GEMINI_API_KEY=

# SUPABASE (Recommended on Vercel via Vercel Marketplace -> Supabase Integration)
# Server-side only — never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional direct Postgres URL (auto-injected by Vercel's Supabase integration).
# Used to auto-bootstrap tables on first cold start or as a direct Postgres fallback.
POSTGRES_URL=
DATABASE_URL=

# APP_URL: The public URL where this app is hosted (optional).
APP_URL=
